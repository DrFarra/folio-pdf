{
  "name": "folio-pdf",
  "version": "0.8.10",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "node scripts/check-release-version.mjs && node scripts/prepare-resources.mjs && tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "demo": "node scripts/create-demo.mjs",
    "test": "npm run build && npm run test:fixtures && npm run test:engine && npm run test:operations && npm run test:page-content:engine && npm run test:content-actions:engine && npm run test:content-actions:ui && npm run test:pdf-editing:ui && npm run test:pdf-content-picker:ui && npm run test:inline-editor && npm run test:conversion && npm run test:responsive-workbench && npm run test:content-editor:engine && npm run test:content-editor:ui && npm run test:content-editor:races && npm run test:content-editor:layout && npm run test:signatures && node scripts/tests/layout.mjs && npm run test:workbench && npm run test:highlighting && npm run test:tabs && npm run test:focus-modality && npm run test:organizer-layout && npm run test:bookmarks && npm run test:selection-menu && npm run test:highlight-mode && npm run test:interop && npm run test:reading-settings && npm run test:remove-highlights && npm run test:bookmark-drag && npm run test:mobile-architecture && npm run test:library-storage && npm run test:search-navigation && npm run test:reader-ergonomics",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "desktop:windows": "tauri build --target x86_64-pc-windows-msvc",
    "desktop:macos": "node scripts/build-macos.mjs",
    "test:macos": "node scripts/tests/mac-platform.mjs",
    "test:fixtures": "node scripts/fetch-test-corpus.mjs",
    "test:engine": "node scripts/tests/engine.mjs",
    "test:ui": "node scripts/tests/workbench.mjs",
    "test:layout": "npm run build && node scripts/tests/layout.mjs",
    "test:interop": "python scripts/tests/interop-operations.py",
    "test:native": "cargo test --manifest-path crates/folio-core/Cargo.toml",
    "test:operations": "node scripts/tests/operations.mjs",
    "test:content-editor:engine": "node scripts/tests/content-editor-engine.mjs",
    "test:content-editor:ui": "node scripts/tests/content-editor-ui.mjs",
    "test:content-editor:layout": "node scripts/tests/content-editor-layout.mjs",
    "test:signatures": "node scripts/tests/signatures.mjs",
    "test:workbench": "node scripts/tests/workbench.mjs",
    "test:highlighting": "node scripts/tests/highlighting.mjs",
    "test:tabs": "node scripts/tests/tabs.mjs",
    "test:bookmarks": "node scripts/tests/bookmarks.mjs",
    "test:selection-menu": "node scripts/tests/selection-menu.mjs",
    "test:highlight-mode": "node scripts/tests/highlight-mode.mjs",
    "test:ui:legacy": "node scripts/verify.mjs",
    "test:interop:legacy": "python scripts/verify-interoperability.py",
    "test:reading-settings": "node scripts/tests/reading-settings.mjs",
    "test:remove-highlights": "node scripts/tests/remove-highlights.mjs",
    "test:bookmark-drag": "node scripts/tests/bookmark-drag.mjs",
    "iphone:build": "node scripts/build-ios.mjs",
    "test:iphone": "node scripts/tests/iphone.mjs",
    "test:reader-ergonomics": "node scripts/tests/reader-ergonomics.mjs",
    "test:focus-modality": "node scripts/tests/focus-modality.mjs",
    "test:organizer-layout": "node scripts/tests/organizer-layout.mjs",
    "test:search-navigation": "node scripts/tests/search-navigation.mjs",
    "test:library-storage": "node scripts/tests/library-storage.mjs",
    "test:mobile-architecture": "node scripts/tests/mobile-architecture.mjs",
    "tauri": "tauri",
    "test:page-content:engine": "node scripts/tests/page-content-engine.mjs",
    "test:pdf-editing:ui": "node scripts/tests/pdf-editing-ui.mjs",
    "test:pdf-content-picker:ui": "node scripts/tests/pdf-content-picker-ui.mjs",
    "test:conversion": "node scripts/tests/conversion.mjs",
    "test:content-editor:races": "node scripts/tests/content-editor-races.mjs",
    "test:responsive-workbench": "node scripts/tests/responsive-workbench.mjs",
    "test:inline-editor": "node scripts/tests/inline-editor-integration.mjs",
    "test:content-actions:engine": "node scripts/tests/content-actions-engine.mjs",
    "test:content-actions:ui": "node scripts/tests/content-actions-ui.mjs",
    "android:build": "node scripts/build-android.mjs",
    "test:drive": "node scripts/tests/drive.mjs",
    "test:android": "node scripts/tests/ink.mjs && node scripts/tests/android-ui.mjs",
    "test:file-picker": "node scripts/tests/file-picker-ui.mjs",
    "test:ink": "node scripts/tests/ink.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.1",
    "@tauri-apps/plugin-dialog": "^2.8.1",
    "asn1js": "3.0.6",
    "docx": "9.8.1",
    "fflate": "0.8.3",
    "lucide-react": "^0.468.0",
    "mupdf": "^1.28.1",
    "node-forge": "1.4.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "6.2.108",
    "pkijs": "3.4.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.1",
    "@types/node-forge": "1.3.14",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "playwright-core": "^1.63.0",
    "typescript": "~5.9.3",
    "vite": "^7.2.2"
  },
  "license": "AGPL-3.0-or-later"
}
