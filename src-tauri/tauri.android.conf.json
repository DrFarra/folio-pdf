{
  "$schema": "https://schema.tauri.app/config/2",
  "version": "0.9.1",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Folio",
        "width": 800,
        "height": 1280,
        "minWidth": 0,
        "minHeight": 0,
        "maximized": false,
        "decorations": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "capabilities": [
        "android-window"
      ]
    }
  },
  "bundle": {
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "android": {
      "minSdkVersion": 26
    },
    "fileAssociations": [],
    "resources": {
      "../LICENSE": "LICENSE.txt",
      "../THIRD-PARTY-NOTICES.txt": "THIRD-PARTY-NOTICES.txt",
      "../SOURCE-BUILD.txt": "SOURCE-BUILD.txt"
    }
  }
}
