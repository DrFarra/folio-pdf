{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Folio",
  "version": "0.8.3",
  "identifier": "org.folio.pdf",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Folio",
        "width": 1360,
        "height": 900,
        "minWidth": 800,
        "minHeight": 600,
        "dragDropEnabled": true,
        "maximized": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost blob: data:; style-src 'self' 'unsafe-inline'; font-src 'self'; object-src 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "shortDescription": "PDF: lectura, edición, OCR, formularios y firmas",
    "category": "Productivity",
    "copyright": "Folio contributors",
    "licenseFile": "../LICENSE",
    "resources": {
      "../assets/pdf-file-icons/icon.ico": "pdf-file.ico",
      "../LICENSE": "LICENSE.txt",
      "../THIRD-PARTY-NOTICES.txt": "THIRD-PARTY-NOTICES.txt",
      "../SOURCE-BUILD.txt": "SOURCE-BUILD.txt"
    },
    "fileAssociations": [
      {
        "ext": [
          "pdf"
        ],
        "name": "Folio.PDF",
        "description": "Documento PDF",
        "role": "Editor"
      }
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "languages": [
          "Spanish",
          "English"
        ],
        "installMode": "currentUser",
        "installerHooks": "installer-hooks.nsh"
      }
    }
  }
}
