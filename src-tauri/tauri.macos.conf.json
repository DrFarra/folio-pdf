{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Folio",
        "width": 1360,
        "height": 900,
        "minWidth": 800,
        "minHeight": 600,
        "dragDropEnabled": true,
        "maximized": true,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 14, "y": 14 }
      }
    ]
  },
  "bundle": {
    "targets": ["app", "dmg"],
    "icon": ["icons/icon.icns"],
    "resources": {
      "../assets/pdf-file-icons/icon.icns": "pdf-file.icns",
      "../LICENSE": "LICENSE.txt",
      "../THIRD-PARTY-NOTICES.txt": "THIRD-PARTY-NOTICES.txt",
      "../SOURCE-BUILD.txt": "SOURCE-BUILD.txt"
    },
    "fileAssociations": [
      {
        "ext": ["pdf"],
        "name": "Folio.PDF",
        "description": "Documento PDF",
        "role": "Editor",
        "mimeType": "application/pdf",
        "contentTypes": ["com.adobe.pdf"],
        "rank": "Alternate"
      }
    ],
    "macOS": {
      "minimumSystemVersion": "14.0",
      "signingIdentity": "-"
    }
  }
}
